{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts", "**/node_modules/**", "**/dist/**", "**/out/**"]
}
